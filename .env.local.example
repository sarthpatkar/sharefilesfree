# Copy this file to .env.local for local development.

# Where the frontend connects for signaling (see /server). Use ws:// locally, wss:// in production.
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080

# Optional TURN relay, used only when a direct P2P connection can't be established
# (roughly 20-30% of connections, more on strict corporate networks). Leave unset
# during local development — the public Google/Twilio STUN servers are enough for
# two devices on normal home networks. Required in production for reliability.
#
# Uses Cloudflare's managed Realtime TURN service (free up to 1,000 GB/month)
# instead of a self-hosted relay — no VPS/UDP-port-range ops needed. Create a
# TURN key at https://dash.cloudflare.com/?to=/:account/calls to get these two
# values; see DEPLOYMENT.md. Both are server-side secrets (never NEXT_PUBLIC_) —
# the server mints a fresh short-lived credential per session via
# /api/turn-credentials rather than shipping a permanent one to the browser.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# --- Storage: none ---
# This service stores no files, so there is nothing to configure here. The R2
# variables that used to live in this block are gone with the upload path; see
# the README's "No storage, on purpose".

# --- Ads (the only revenue path — see README's "Ads" section) ---
# Nothing here set = no ad script, no ad slots, no ad gates. The site behaves
# exactly as it does with this file untouched, so it's safe to deploy without.
#
# Your AdSense publisher id. Setting this turns on real ads everywhere:
# banner slots on every page, and the short gates on the transfer and link
# paths (never on the tools — they carry banners only, never a gate).
# NEXT_PUBLIC_AD_CLIENT=ca-pub-0000000000000000
#
# Draw labelled placeholders instead of real ads, so the layout and the gate
# timing can be reviewed before an ad account exists. Ignored when
# NEXT_PUBLIC_AD_CLIENT is set.
# NEXT_PUBLIC_AD_HOUSE=1

# --- Optional monetization stopgap before AdSense is approved ---
# A donation link (Buy Me a Coffee, UPI, etc.) shown in the footer. Left
# unset by default — we don't fabricate a payment destination; set this to
# your real link when you have one.
# NEXT_PUBLIC_DONATE_URL=
