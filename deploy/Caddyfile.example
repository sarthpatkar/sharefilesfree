# Caddy config for the whole deployment: the website and the signaling server.
#
# Copy to /etc/caddy/Caddyfile on the VPS, then:
#   sudo systemctl reload caddy
#
# ---------------------------------------------------------------------------
# CERTIFICATES, AND WHY THIS CHANGED
# ---------------------------------------------------------------------------
# This file previously told you to keep DNS records on "DNS only" (grey cloud)
# so Caddy could complete an HTTP-01 Let's Encrypt challenge directly. That
# works, but it publishes your origin IP — anyone can then DDoS or port-scan
# the box straight past Cloudflare. Measured on 4 Sep 2026, that is exactly
# the position toffeeshare.com is in (origin 206.189.1.166 openly reachable),
# while snapdrop.net, wormhole.app and ilovepdf.com are all fully proxied.
#
# So: set all three records to PROXIED (orange cloud) in Cloudflare, and use
# the DNS-01 challenge below instead of HTTP-01. DNS-01 proves domain control
# via a TXT record, so it works fine behind the proxy.
#
# DNS-01 needs the Cloudflare DNS plugin, which is NOT in the default Caddy
# binary. Either download a build with it from https://caddyserver.com/download
# (select "github.com/caddy-dns/cloudflare"), or run:
#   sudo caddy add-package github.com/caddy-dns/cloudflare
#   sudo systemctl restart caddy
#
# CF_API_TOKEN must be a Cloudflare API token with Zone:DNS:Edit on this zone
# only — not a Global API Key. Put it in /etc/default/caddy as
#   CF_API_TOKEN=...
# and keep that file chmod 600, root-owned.
# ---------------------------------------------------------------------------

{
	# Applies to every site below unless overridden.
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# --- The website ------------------------------------------------------------
sharefilesfree.com {
	encode zstd gzip

	# Next.js hashes its static asset filenames, so they are safe to cache
	# hard and forever. Cloudflare respects this, which is what keeps origin
	# egress low once the site is proxied.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# --- Letting Cloudflare's edge serve the prerendered pages --------------
	#
	# Every route on this site except /api/turn-credentials is prerendered at
	# build time, yet measured on the live deployment every single page view was
	# reaching this box: `cf-cache-status: DYNAMIC` on every route, including all
	# nineteen tool pages, which are the entire SEO strategy. One 1-vCPU origin
	# was in the path of all of it.
	#
	# Two things prevent edge caching by default, and both have to be handled:
	#
	#   1. Cloudflare does not cache HTML unless a Cache Rule says to. That part
	#      lives in the dashboard, not here — see DEPLOYMENT.md.
	#   2. Cloudflare will not cache a response that Varies on anything except
	#      Accept-Encoding, and Next.js varies on its RSC negotiation headers.
	#
	# So the two request shapes are separated. A client-side navigation or
	# prefetch carries the RSC header, keeps the full Vary, and is never cached.
	# A plain document request — what a first-time visitor and a search crawler
	# both send — gets a clean, cacheable response.
	#
	# The TTL is deliberately short. A deploy changes the HTML and the hashed
	# chunk URLs it references together, so HTML cached for long enough could
	# outlive the chunks it points at — the same class of failure the service
	# worker had. Sixty seconds still collapses origin load by orders of
	# magnitude under a traffic spike, which is the point, while keeping the
	# stale window shorter than a deploy takes.
	@document {
		not header RSC *
		not path /api/*
		not path /_next/*
	}
	# `defer` matters and is not decoration. Without it these operations run
	# before reverse_proxy copies the upstream's own headers in, so the response
	# carries BOTH values — two Cache-Control lines and two Vary lines — and
	# Cloudflare reads the Next.js pair. Deferring applies them at write time,
	# after the upstream headers land, which replaces rather than appends.
	header @document {
		Vary "Accept-Encoding"
		Cache-Control "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
		defer
	}

	# The other half, and it is a correctness guard rather than an optimisation.
	# An RSC response is a payload for one specific route transition, and it
	# arrives with a Vary on headers Cloudflare does not honour — so if anything
	# ever made these cacheable, the edge could hand one route's payload to a
	# request for another and client-side navigation would break in a way that
	# is very hard to trace. The origin should say what it means rather than
	# relying on a CDN rule to exclude them.
	@rsc header RSC *
	header @rsc {
		Cache-Control "private, no-store"
		defer
	}

	reverse_proxy localhost:3000 {
		# A deploy restarts the app, and for the second or two it takes, every
		# request would otherwise fail — Cloudflare turns that into a 522 for
		# real visitors. Observed live on 5 Sep 2026. Retrying a refused
		# upstream for a few seconds turns a visible error into a short pause.
		#
		# This only retries connections that were refused outright, so a
		# request that already started streaming is never replayed.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

# --- www redirects to the apex ---------------------------------------------
www.sharefilesfree.com {
	redir https://sharefilesfree.com{uri} permanent
}

# --- The signaling server ---------------------------------------------------
# Caddy proxies WebSocket upgrades transparently; no special config needed.
# Cloudflare also proxies WebSockets on the free plan, so this works orange.
signal.sharefilesfree.com {
	reverse_proxy localhost:8080
}
