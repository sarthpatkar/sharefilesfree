# systemd unit for the signaling server — keeps it running after you log out
# of the VPS and restarts it automatically if it ever crashes.
#
# Install: sudo cp deploy/signaling.service /etc/systemd/system/signaling.service
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now signaling
# Logs:    sudo journalctl -u signaling -f
[Unit]
Description=ShareFilesFree signaling server
After=network.target

[Service]
Type=simple
User=sendfilesfree
WorkingDirectory=/home/sendfilesfree/sendfilesfree/server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
Environment=PORT=8080

# --- Hardening. This process needs no filesystem writes at all. ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
